// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  CLIENT
}

enum DeliverableType {
  DESIGN
  DOC
}

enum VersionKind {
  STATIC_IMAGE
  STATIC_PDF
  MARKDOWN
  PROTOTYPE_URL
}

enum DecisionState {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum BlockerStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// Account-shaped: an isolated client tenant.
model Company {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  members   User[]
  projects  Project[]
}

// Contact-shaped for client members; also holds staff users (companyId null).
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       Role
  isApprover Boolean  @default(false)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())

  sessions        Session[]
  magicLinks      MagicLink[]
  comments        Comment[]
  blockerComments BlockerComment[]
  decidedVersions Version[]        @relation("VersionDecidedBy")
  ownedBlockers   Blocker[]        @relation("BlockerOwner")
  notifications   Notification[]
}

model MagicLink {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Global ordered phase list, shared across every project (placeholder labels for now).
model Phase {
  id           String        @id @default(cuid())
  name         String
  order        Int           @unique
  deliverables Deliverable[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  deliverables Deliverable[]
  blockers     Blocker[]
}

model Deliverable {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id])
  phaseId   String?
  phase     Phase?          @relation(fields: [phaseId], references: [id])
  type      DeliverableType
  title     String
  createdAt DateTime        @default(now())

  versions Version[]
}

model Version {
  id              String        @id @default(cuid())
  deliverableId   String
  deliverable     Deliverable   @relation(fields: [deliverableId], references: [id])
  versionNumber   Int
  kind            VersionKind
  fileUrl         String?
  content         String?
  prototypeUrl    String?
  createdAt       DateTime      @default(now())
  decisionState   DecisionState @default(PENDING)
  decisionComment String?
  decidedById     String?
  decidedBy       User?         @relation("VersionDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?

  threads CommentThread[]
}

model CommentThread {
  id          String   @id @default(cuid())
  versionId   String
  version     Version  @relation(fields: [versionId], references: [id])
  xPct        Float?
  yPct        Float?
  resolved    Boolean  @default(false)
  pinnedToTop Boolean  @default(false)
  createdAt   DateTime @default(now())

  comments Comment[]
}

model Comment {
  id        String        @id @default(cuid())
  threadId  String
  thread    CommentThread @relation(fields: [threadId], references: [id])
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime      @default(now())
}

model Blocker {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  title       String
  description String?
  ownerId     String?
  owner       User?         @relation("BlockerOwner", fields: [ownerId], references: [id])
  status      BlockerStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  comments BlockerComment[]
}

// Email is the only notification channel in v1. There is no SMTP/provider wired up here,
// so sends are logged as rows instead — the same "dev inbox" pattern used for magic links.
model Notification {
  id        String   @id @default(cuid())
  toUserId  String
  toUser    User     @relation(fields: [toUserId], references: [id])
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model BlockerComment {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Blocker  @relation(fields: [blockerId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}
